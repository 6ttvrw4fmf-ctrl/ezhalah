# Supabase project "ezhalah app" (ref aannarbkwcymrotzwdbo). EXPO_PUBLIC_* vars are baked into the
# client bundle and exposed to users — only put the publishable key here, never the service role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx

# Observability (Sentry) — client-side crash telemetry, owner-added 2026-08-26.
# Fully opt-in: leaving these blank makes src/lib/observability.ts a total no-op. No requests
# leave the device. See the module's header for the PDPL scrubbing contract (no PII, no tokens,
# no query strings, no cookies — enforced by scrubEvent, executed by
# scripts/verify-observability-pdpl-scrub.ts).
# PDPL: pick the EU-region DSN (Sentry Frankfurt) if data residency matters — the DSN itself
# is what routes events. The org can be created at sentry.io/signup then a new project of type
# `react-native`; the DSN appears in Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
# Optional: environment tag (defaults to 'production' when omitted). Common values: preview, staging.
EXPO_PUBLIC_SENTRY_ENV=
# Optional: release name (git sha or semver) so a spike can be tied to a specific bundle.
EXPO_PUBLIC_SENTRY_RELEASE=
